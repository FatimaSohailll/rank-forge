# Copy to backend/.env for local dev. For Vercel, follow docs/VERCEL.md rather than importing local settings.
# On Hugging Face, add these as Space secrets.
# NEVER commit the real .env.

# --- Claude (your group's key) ---
ANTHROPIC_API_KEY=sk-ant-...
MODEL_ID=claude-haiku-5-5

# --- Tavily (web search, fetch, SERP position checks; free tier) ---
TAVILY_API_KEY=tvly-...

# --- Postgres (Supabase) ---
# Use the *pooler* connection string (IPv4), port 6543, from
# Supabase -> Project Settings -> Database -> Connection string -> Transaction pooler.
# Leave empty for local dev to fall back to in-memory checkpoints (NOT for deployment).
DATABASE_URL=postgresql://postgres.xxxx:password@aws-0-region.pooler.supabase.com:6543/postgres

# --- Website (one deployment: FastAPI serves the API and the pages) ---
# Comma-separated origins allowed by CORS
ALLOWED_ORIGINS=http://localhost:8000
# Public HTTPS URL of the deployed app (Vercel production domain or HF Space URL)
PUBLIC_SITE_URL=http://localhost:8000

# --- Cron / admin ---
CRON_SECRET=change-me

# --- Cost guard ---
MAX_SPEND_PER_RUN_USD=0.02
DAILY_SPEND_CEILING_USD=1.50

# --- Auth ---
# Long random string (python -c "import secrets; print(secrets.token_urlsafe(48))"). Required in production.
SESSION_SECRET=
# true when served over HTTPS
COOKIE_SECURE=false
# Creates/updates the 'admin' account at startup (admin dashboard at /admin)
ADMIN_PASSWORD=
# Password for demo_alice / demo_bob, set by scripts/init_db.py (random if empty; printed once)
DEMO_PASSWORD=
